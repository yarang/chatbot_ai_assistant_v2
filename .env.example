# App
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-string

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-pro

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_URL=https://your-domain.ngrok-free.app/webhook
TELEGRAM_MESSAGE_LIMIT=4000
TELEGRAM_UPDATE_INTERVAL=0.5
TELEGRAM_MAX_FILE_SIZE=10485760

# Telegram Webhook Security
# Secret token for webhook verification (RECOMMENDED FOR PRODUCTION)
# Generate a random string: openssl rand -hex 32
# When setting webhook, use: --secret-token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_here

# Web Search Engine Configuration
# Options: ddg (DuckDuckGo), tavily, google
# Default: ddg (free, no API key required)
SEARCH_ENGINE=ddg
SEARCH_MAX_RESULTS=3
SEARCH_TIMEOUT=10.0

# DuckDuckGo (ddg) - No API key required

# Tavily Search - Premium search engine
# Get API key at https://tavily.com
SEARCH_TAVILY_API_KEY=your_tavily_api_key_here

# Google Custom Search - Free tier: 100 queries/day
# Get API key at https://console.cloud.google.com
# Create CSE at https://cse.google.com
SEARCH_GOOGLE_API_KEY=your_google_api_key_here
SEARCH_GOOGLE_CSE_ID=your_google_cse_id_here

# Legacy: TAVILY_API_KEY (deprecated, use SEARCH_TAVILY_API_KEY)
TAVILY_API_KEY=your_tavily_api_key_here

# Access Control
ADMIN_IDS=[12345678, 87654321]

# Integrations
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_db_id_here

# Local LLM Configuration (Hybrid Router)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://172.16.1.101:11434
LOCAL_LLM_MODEL=llama-3.1-8b
LOCAL_LLM_TIMEOUT=10.0

# Agent Configuration
AGENT_RECURSION_LIMIT=20

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=chatbot_db
